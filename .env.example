# Copy to .env and fill in. Real environment variables override this file.

# Google AI Studio API key (https://aistudio.google.com/apikey). Used for
# generation and embeddings.
GOOGLE_AI_API_KEY=

# Neon Postgres connection string (pooled endpoint is fine).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional. Changing the model re-embeds every chunk on the next ingest.
# EMBEDDING_MODEL=gemini-embedding-2
# EMBEDDING_BATCH_SIZE=50

# Copy to .env and fill in. Real environment variables override this file.

# Google AI Studio API key (https://aistudio.google.com/apikey). Used for
# generation and embeddings.
GOOGLE_AI_API_KEY=

# Neon Postgres connection string (pooled endpoint is fine).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional. Changing the model re-embeds every chunk on the next ingest.
# EMBEDDING_MODEL=gemini-embedding-2
# EMBEDDING_BATCH_SIZE=50

# --- HTTP API only (uv run uvicorn app:app / Vercel) ---

# Secret for HMAC-ing visitor IPs in rate-limit counters (raw IPs are never stored).
# Generate: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
RATE_LIMIT_HASH_KEY=

# Header carrying the real client IP from a trusted proxy. On Vercel:
# CLIENT_IP_HEADER=x-vercel-forwarded-for
# Leave unset locally (uses the socket address). Never name a header clients can forge.

# Optional limits. Keep the daily cap under your Gemini free-tier daily limits.
# VISITOR_RATE_LIMIT_REQUESTS=10
# VISITOR_RATE_LIMIT_WINDOW_SECONDS=600
# DAILY_QUESTION_CAP=200

# Optional answering settings.
# GENERATION_MODEL=gemini-3.1-flash-lite
# RETRIEVAL_TOP_K=5
# HYBRID_SEARCH=true   # false = vector search only, for comparing on the eval suite
# MIN_SIMILARITY=0.62
# CONTACT_EMAIL=me@devarash.icu
